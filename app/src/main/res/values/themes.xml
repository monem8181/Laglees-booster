<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (used at runtime by Compose) -->
    <style name="Theme.LagLess" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
    </style>

    <!-- Splash screen theme - shown before Activity is ready -->
    <style name="Theme.LagLess.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LagLess</item>
    </style>
</resources>
