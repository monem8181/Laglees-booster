{
  "manifest_version": 3,
  "name": "Chess Arrow Master Mobile",
  "version": "1.0.0",
  "description": "Touch-based arrow drawing and square highlighting overlay for Chess.com on mobile browsers.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "css": ["styles/overlay.css", "styles/toolbar.css"],
      "js": [
        "content/boardDetector.js",
        "content/squareMapper.js",
        "content/overlayEngine.js",
        "content/arrowRenderer.js",
        "content/touchHandler.js",
        "content/toolbar.js",
        "content/settings.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
